# Frontend environment variables for Recipe Hub

# Base URL for backend API (FastAPI). Must include protocol and port.
REACT_APP_API_BASE=http://localhost:3001

# Public URL where this frontend is served (used by backend CORS/config docs and future redirects).
REACT_APP_FRONTEND_URL=http://localhost:3000

# Optional WebSocket base URL if used in future (not currently used).
REACT_APP_WS_URL=

# Standard React env toggles
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/healthz

# Feature flags (JSON or comma-separated string), and experiments
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
