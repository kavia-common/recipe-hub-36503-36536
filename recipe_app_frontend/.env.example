# Frontend environment configuration
# IMPORTANT: Set REACT_APP_API_BASE to the backend HTTP base URL.
# In local dev:
#   REACT_APP_API_BASE=http://localhost:3001
# In preview (Kavia cloud), set to the provided backend URL (likely https and non-localhost).
REACT_APP_API_BASE=http://localhost:3001

# Optional: set to your frontend's public URL (used for backend CORS config if injected).
REACT_APP_FRONTEND_URL=http://localhost:3000

# Optional WebSocket base if added in future
REACT_APP_WS_URL=

# Node environment and flags
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=1

# App port (CRA uses 3000 by default)
REACT_APP_PORT=3000

# Observability and health
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/

# Flags
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=
